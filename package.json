{
    "name": "vue3-mapbpox-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.20.0",
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "patch-package && vite",
        "build": "patch-package && vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@antv/l7": "^2.29.1",
        "@antv/l7-maps": "^2.29.1",
        "@remixicon/vue": "^4.9.0",
        "@turf/turf": "^7.4.0",
        "@vueuse/core": "^15.0.0",
        "dayjs": "^1.11.19",
        "echarts": "^6.1.0",
        "js-md5": "^0.8.3",
        "mitt": "^3.0.1",
        "naive-ui": "2.41.0",
        "pinia": "^3.0.4",
        "umi-request": "^1.4.0",
        "vfonts": "^0.0.3",
        "vue": "^3.5.24",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@types/geojson": "^7946.0.16",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vue/eslint-config-typescript": "^14.0.0",
        "@vue/tsconfig": "^0.8.1",
        "autoprefixer": "^10.4.23",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^9.30.0",
        "less": "^4.5.1",
        "patch-package": "^7.0.2",
        "postcss": "^8.5.6",
        "prettier": "^3.4.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.3",
        "unplugin-vue-components": "^28.0.0",
        "vite": "^7.2.5",
        "vite-plugin-compression": "^0.5.1",
        "vue-tsc": "^3.1.4"
    }
}
